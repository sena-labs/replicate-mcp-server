node_modules/
dist/
*.log
.DS_Store

# Env files — only the *.example templates are tracked; real ones never are.
.env
.env.*
!.env.example
!*.env.example

# Agent / AI tooling state: session transcripts, daemon PIDs, metrics and
# scratch notes. Machine-local and may quote file contents, prompts or tokens.
.claude/
.claude-flow/
.ruflo/
.remember/
.serena/
*.pid

# Editor / IDE
.idea/
*.swp
*.swo

# TypeScript incremental build info
*.tsbuildinfo

# Runtime artifacts
*.db
mcpo*.json
mcpo.err
mcpo.log
test-sdk.mjs
ruvector.db

# MCPB build output (manifest + build script are tracked; artifacts are not)
mcpb/build/
mcpb/*.mcpb

# Image-generation exploration (chosen assets/icon.png + assets/banner.png tracked)
assets/candidates/
assets/banner-candidates/
# Compositor build artifact (regenerable via scripts/compose-banner.mjs; banner.png is the shipped copy)
assets/banner-ad.png

# Playwright MCP session scratch
.playwright-mcp/

# Deploy secrets (PUBLIC_IP / domain / ACME email live only on the host)
deploy/.env
.tmp/
