# Dedicated Caddy serving a single MCP hostname.
# Domain + ACME email come from the environment (set in deploy/.env).
{
	email {$ACME_EMAIL}
	# Runtime warnings/errors also contain request objects, outside access logs.
	log default {
		format filter {
			request>headers delete
			request>uri regexp "[?].*$" ""
			wrap json
		}
	}
}

{$MCP_DOMAIN} {
	reverse_proxy replicate-mcp:8088 {
		# Overwrite client-supplied values; MCP trusts only this proxy's peer IP.
		header_up X-Real-IP {remote_host}
	}

	# Don't advertise the server software.
	header -Server

	# BYOK is public. Never retain request headers or query credentials.
	log {
		output stdout
		format filter {
			request>headers delete
			request>uri regexp "[?].*$" ""
			wrap json
		}
	}
}
