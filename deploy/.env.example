# Copy to deploy/.env (gitignored) on the VPS and fill in with real values.
# Every value below is a placeholder — do not commit the filled-in file.

# Public IPv4 of the host — Caddy binds ONLY this IP for 80/443.
PUBLIC_IP=203.0.113.10
# The public hostname clients (and the Smithery scanner) will reach.
MCP_DOMAIN=mcp.example.com
# Email for the Let's Encrypt account (expiry notices).
ACME_EMAIL=you@example.com
